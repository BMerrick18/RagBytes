# Settings for one app stack (docker-compose.yml). On the server this is /opt/ragbyte/<stack>/.env;
# deploys write COMPOSE_PROJECT_NAME, STACK, IMAGE_TAG and PUBLIC_API_URL themselves.
COMPOSE_PROJECT_NAME=ragbyte-dev
STACK=dev
IMAGE_TAG=latest

# Public address of this stack's API, shown on the website's API docs page.
PUBLIC_API_URL=https://api-dev.example.com

# Uvicorn worker processes for the API.
API_WORKERS=1
