# Copy to /opt/ragbyte/edge/.env on the server.
PROD_DOMAINS=example.com, www.example.com
DEV_DOMAIN=dev.example.com
# One level below the zone, so the Cloudflare edge certificate and *.example.com origin certificate cover them.
PROD_API_DOMAIN=api.example.com
DEV_API_DOMAIN=api-dev.example.com

# Folder outside the repository holding the Cloudflare Origin Certificate
# as origin.pem and its private key as origin.key.
CERTS_DIR=/etc/ragbyte/certs
